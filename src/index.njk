---
layout: layouts/base.njk
title: Trace — Printable name worksheets
description: Make printable tracing worksheets for your child’s name. Choose size, manuscript or cursive, and solid, dotted, or faded letters.
---

<header class="hero no-print">
  <div class="hero__inner">
    <p class="hero__brand">Trace</p>
    <p class="hero__tagline">Printable name worksheets for little hands</p>
  </div>
</header>

<main class="tool">
  <section class="controls no-print" aria-label="Worksheet options">
    <div class="controls__grid">
      <div class="field field--wide">
        <span class="field__label">Pages</span>
        <p class="field__help">Same layout on every page — change the word for each one.</p>
        <div id="pages-list" class="pages-list" aria-label="Worksheet pages"></div>
      </div>

      <fieldset class="field">
        <legend class="field__label">Script</legend>
        <div class="segmented" role="radiogroup" aria-label="Script">
          <label class="segmented__option">
            <input type="radio" name="script" value="manuscript" checked>
            <span>Manuscript</span>
          </label>
          <label class="segmented__option">
            <input type="radio" name="script" value="cursive">
            <span>Cursive</span>
          </label>
        </div>
      </fieldset>

      <div class="field field--wide">
        <span class="field__label">Line pattern</span>
        <p class="field__help">Styles repeat down the page. Use Guides only for blank practice lines.</p>
        <div id="line-pattern" class="line-pattern" aria-label="Line pattern"></div>
      </div>

      <label class="field">
        <span class="field__label">Size <span id="size-value" class="field__hint">48</span></span>
        <input
          type="range"
          id="size-input"
          class="field__range"
          min="28"
          max="96"
          step="2"
          value="48"
        >
      </label>

      <fieldset class="field">
        <legend class="field__label">Page</legend>
        <div class="segmented" role="radiogroup" aria-label="Page size">
          <label class="segmented__option">
            <input type="radio" name="page" value="a4" checked>
            <span>A4</span>
          </label>
          <label class="segmented__option">
            <input type="radio" name="page" value="letter">
            <span>Letter</span>
          </label>
        </div>
      </fieldset>

      <label class="field field--check">
        <input type="checkbox" id="guides-input" checked>
        <span>Handwriting guide lines</span>
      </label>
    </div>

    <div class="controls__actions">
      <button type="button" id="print-btn" class="btn btn--primary">Print worksheet</button>
    </div>
  </section>

  <section class="preview" aria-label="Worksheet preview">
    <p class="preview__label no-print">Preview</p>
    <div id="worksheet-pages" class="preview__frame"></div>
  </section>
</main>
