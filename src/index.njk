---
layout: layouts/base.njk
title: Trace — Printable name worksheets
description: Make printable tracing worksheets for your child’s name. Choose size, manuscript or cursive, and solid, dotted, or faded letters.
---

<header class="hero no-print">
  <div class="hero__staff" aria-hidden="true">
    <span class="hero__staff-line hero__staff-line--top"></span>
    <span class="hero__staff-line hero__staff-line--mid"></span>
    <span class="hero__staff-line hero__staff-line--base"></span>
    <span class="hero__staff-line hero__staff-line--desc"></span>
  </div>

  <div class="hero__inner">
    <h1 class="hero__brand">
      <span class="hero__brand-label">Print&amp;Trace</span>
      <svg class="hero__mark" viewBox="0 0 640 150" aria-hidden="true" focusable="false">
        <text class="hero__mark-ghost" x="320" y="108" text-anchor="middle">Print&amp;Trace</text>
        <text class="hero__mark-dash" x="320" y="108" text-anchor="middle">Print&amp;Trace</text>
        <text class="hero__mark-ink" x="320" y="108" text-anchor="middle">Print&amp;Trace</text>
      </svg>
    </h1>
    <p class="hero__tagline">Printable name worksheets for little hands</p>
    <svg class="hero__trail" viewBox="0 0 320 36" aria-hidden="true" focusable="false">
      <path
        class="hero__trail-path"
        d="M8 22 C 48 6, 92 30, 140 16 S 220 4, 312 20"
        fill="none"
        pathLength="100"
      />
      <circle class="hero__trail-tip" r="4.5" cx="8" cy="22" />
    </svg>
  </div>
</header>

<main class="tool">
  <section class="controls no-print" aria-label="Worksheet options">
    <div class="controls__grid">
      <div class="field field--wide">
        <span class="field__label">Pages</span>
        <p class="field__help">Same layout on every page — change the word for each one.</p>
        <div id="pages-list" class="pages-list" aria-label="Worksheet pages"></div>
      </div>

      <fieldset class="field">
        <legend class="field__label">Script</legend>
        <div class="segmented" role="radiogroup" aria-label="Script">
          <label class="segmented__option">
            <input type="radio" name="script" value="manuscript" checked>
            <span>Manuscript</span>
          </label>
          <label class="segmented__option">
            <input type="radio" name="script" value="cursive">
            <span>Cursive</span>
          </label>
        </div>
      </fieldset>

      <div class="field field--wide">
        <span class="field__label">Line pattern</span>
        <p class="field__help">Styles repeat down the page. Use Guides only for blank practice lines.</p>
        <div id="line-pattern" class="line-pattern" aria-label="Line pattern"></div>
      </div>

      <label class="field">
        <span class="field__label">Size <span id="size-value" class="field__hint">48</span></span>
        <input
          type="range"
          id="size-input"
          class="field__range"
          min="28"
          max="96"
          step="2"
          value="48"
        >
      </label>

      <fieldset class="field">
        <legend class="field__label">Paper</legend>
        <div class="segmented" role="radiogroup" aria-label="Paper size">
          <label class="segmented__option">
            <input type="radio" name="page" value="a4" checked>
            <span>A4</span>
          </label>
          <label class="segmented__option">
            <input type="radio" name="page" value="letter">
            <span>Letter</span>
          </label>
        </div>
      </fieldset>

      <label class="field field--check">
        <input type="checkbox" id="guides-input" checked>
        <span>Handwriting guide lines</span>
      </label>
    </div>

    <div class="controls__actions">
      <button type="button" id="print-btn" class="btn btn--primary">Print</button>
    </div>
  </section>

  <section class="preview" aria-label="Worksheet preview">
    <p class="preview__label no-print">Preview</p>
    <div id="worksheet-pages" class="preview__frame"></div>
  </section>

  <footer class="site-footer no-print">
    <a
      class="bmc-button"
      href="https://www.buymeacoffee.com/vcwd"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
        alt="Buy me a coffee"
        width="217"
        height="60"
        loading="lazy"
      >
    </a>
  </footer>
</main>
